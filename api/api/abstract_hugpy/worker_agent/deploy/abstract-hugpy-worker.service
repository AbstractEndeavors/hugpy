[Unit]
Description=abstract_hugpy GPU worker (donates this box's GPU to the central console)
Documentation=https://github.com/AbstractEndeavors/abstractgpt
# Start after the network — and after WireGuard if you reach central over it.
After=network-online.target
Wants=network-online.target
# If you use wg-quick, uncomment to wait for the tunnel:
#After=wg-quick@wg0.service
#Wants=wg-quick@wg0.service
# Restart-throttle window lives in [Unit] (NOT [Service]); 0 = never give up.
StartLimitIntervalSec=0

[Service]
Type=simple
# Configure everything via the env file (copy from the .env.example).
EnvironmentFile=/etc/abstract-hugpy-worker.env

# Run the agent module. Adjust the python path / venv as needed:
#   - system python with abstract_hugpy installed:  /usr/bin/python3
#   - a venv:  /opt/abstract_hugpy/venv/bin/python
# This python MUST be able to `import abstract_hugpy` AND have the GPU inference
# deps (llama-cpp-python built with CUDA, and/or torch + transformers).
ExecStart=/usr/bin/python3 -m abstract_hugpy.worker_agent

# Service account + state dir (systemd creates /var/lib/abstract-hugpy-worker).
User=hugpy
Group=hugpy
StateDirectory=abstract-hugpy-worker

# GPU access: the service user must be in the group(s) that own the NVIDIA
# device nodes. On most distros that's "video" (and "render" for newer ones).
# Check with:  ls -l /dev/nvidia*    and use whatever group is shown.
SupplementaryGroups=video render

# Resilience: restart on crash, keep trying so it rejoins after a reboot or a
# transient central/WireGuard outage.
Restart=always
RestartSec=5

# Model loads/inference can take a while; don't time out or OOM-kill eagerly.
TimeoutStartSec=0
KillSignal=SIGINT

# ── Optional hardening ──────────────────────────────────────────────────────
# Left OFF by default because the common failure mode on a GPU box is the
# sandbox blocking /dev/nvidia* or your model storage. If you want hardening,
# uncomment these and make sure the allowances below cover your paths:
#NoNewPrivileges=true
#ProtectSystem=strict
#ProtectHome=read-only
# Writable paths the worker needs (state dir is already writable). Add your
# model storage root (DEFAULT_ROOT) so provisioning can write models. A worker
# uses LOCAL storage (no central mount), e.g. ~hugpy/.abstract_hugpy/storage:
#ReadWritePaths=/home/hugpy/.abstract_hugpy/storage /var/lib/abstract-hugpy-worker
# Explicitly allow the GPU device nodes when using DevicePolicy:
#DeviceAllow=/dev/nvidiactl rw
#DeviceAllow=/dev/nvidia0 rw
#DeviceAllow=/dev/nvidia-uvm rw

[Install]
WantedBy=multi-user.target
