# abstract_hugpy GPU worker — systemd configuration.
#
# Copy to /etc/abstract-hugpy-worker.env and edit. The unit file reads this via
# EnvironmentFile=, so you configure the worker here without touching the unit.

# REQUIRED: central console base URL (over WireGuard, point at central's WG IP).
WORKER_CENTRAL_URL=http://10.6.0.1

# Friendly name shown in the console (defaults to hostname if unset).
WORKER_NAME=gpu-box-1

# Where this worker's inference server listens.
WORKER_HOST=0.0.0.0
WORKER_PORT=9100

# URL central calls back on. Set to this box's reachable address (WireGuard IP).
# Defaults to http://<resolved-host>:<port> if left blank.
WORKER_URL=http://10.6.0.2:9100

# Optional: comma-separated model_keys to self-assign on registration.
#WORKER_MODELS=

# Heartbeat interval (seconds).
WORKER_HEARTBEAT=15

# Persisted worker id (keeps assignments across restarts). Must be writable by
# the service user.
WORKER_ID_FILE=/var/lib/abstract-hugpy-worker/worker.json

# ── GPU/CPU spill ──────────────────────────────────────────────────────────
# auto = fit as many layers on the GPU as VRAM allows, spill the rest to CPU.
# off  = CPU only.
WORKER_SPILL=auto
# Force llama.cpp layers on GPU (overrides WORKER_SPILL):
#WORKER_N_GPU_LAYERS=20
# transformers memory budgets (GiB):
#WORKER_GPU_MEM_GIB=7
#WORKER_CPU_MEM_GIB=24
# Multi-GPU on one box:
#WORKER_TENSOR_SPLIT=0.7,0.3
#WORKER_MAIN_GPU=0

# Where models live on this worker. A worker does NOT need central's /mnt mount:
# it downloads each assigned model once from central over HTTP and caches it
# here (faster than serving weights live over sshfs/NFS). Use a LOCAL path so a
# missing/broken mount never matters. Must be writable by the service user.
DEFAULT_ROOT=/home/hugpy/.abstract_hugpy/storage

# Optional Hugging Face token for the HF download fallback.
#HF_TOKEN=
